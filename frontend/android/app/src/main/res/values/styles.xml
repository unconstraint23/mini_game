<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#070B14</item>
        <item name="colorPrimaryDark">#070B14</item>
        <item name="colorAccent">#22D3EE</item>
        <item name="android:windowBackground">#070B14</item>
        <item name="android:statusBarColor">#070B14</item>
        <item name="android:navigationBarColor">#070B14</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowBackground">#070B14</item>
        <item name="android:statusBarColor">#070B14</item>
        <item name="android:navigationBarColor">#070B14</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:windowBackground">#070B14</item>
        <item name="android:statusBarColor">#070B14</item>
        <item name="android:navigationBarColor">#070B14</item>
    </style>
</resources>
